# ===========================================================================
# FII RAG Agent — variáveis de ambiente
# ---------------------------------------------------------------------------
# Tudo abaixo é opcional, exceto as API keys. Defaults razoáveis estão em
# server/src/fii_rag/config.py. Os campos legados MISTRAL_MODEL e GOOGLE_MODEL
# continuam sendo respeitados como fallback.
# ===========================================================================

# --- Chaves de API ---------------------------------------------------------
MISTRAL_API_KEY="sua_chave_da_mistral_aqui"
GOOGLE_API_KEY="sua_chave_do_google_ai_studio_aqui"
# OPENAI_API_KEY="opcional"

# --- Qdrant ----------------------------------------------------------------
QDRANT_URL="http://localhost:6333"

# --- Embeddings ------------------------------------------------------------
# Provedor e modelo dos embeddings densos. Provider ∈ {google, mistral, openai}.
DENSE_EMBED_PROVIDER="google"
DENSE_EMBED_MODEL="text-embedding-004"
DENSE_EMBED_DIM=768

# Modelo esparso para hybrid search (FastEmbed). BM25 é o default recomendado.
SPARSE_EMBED_MODEL="Qdrant/bm25"

# --- LLM por estágio -------------------------------------------------------
# Cada estágio tem provider/modelo/temperatura próprios.
# Provider ∈ {mistral, google, openai}.

# Resposta final do agente
CHAT_LLM_PROVIDER="mistral"
CHAT_LLM_MODEL="mistral-large-latest"
CHAT_LLM_TEMPERATURE=0.1

# Sumário do documento + extração de metadados-doc (ticker, CNPJ, datas)
DOC_SUMMARY_LLM_PROVIDER="mistral"
DOC_SUMMARY_LLM_MODEL="mistral-large-latest"
DOC_SUMMARY_LLM_TEMPERATURE=0.0

# Extração de metadados por chunk (title, keywords, summary local)
CHUNK_METADATA_LLM_PROVIDER="mistral"
CHUNK_METADATA_LLM_MODEL="mistral-small-latest"
CHUNK_METADATA_LLM_TEMPERATURE=0.0

# Reranker (alternativa LLM-as-reranker; default usa cross-encoder local)
RERANK_BACKEND="cross_encoder"  # cross_encoder | llm
RERANK_CROSS_ENCODER_MODEL="BAAI/bge-reranker-base"
RERANK_LLM_PROVIDER="mistral"
RERANK_LLM_MODEL="mistral-small-latest"

# --- Pipeline de ingestão --------------------------------------------------
INGEST_MAX_WORKERS=4

# --- Chunking --------------------------------------------------------------
RECURSIVE_CHUNK_SIZE=1000
RECURSIVE_CHUNK_OVERLAP=200
SEMANTIC_BREAKPOINT_THRESHOLD_TYPE="percentile"
SEMANTIC_BREAKPOINT_THRESHOLD_AMOUNT=95
HIERARCHICAL_PARENT_SIZE=2000
HIERARCHICAL_CHILD_SIZE=400
HIERARCHICAL_CHILD_OVERLAP=50

# --- Retrieval -------------------------------------------------------------
STAGE1_TOP_K=8
STAGE2_TOP_K_PER_STRATEGY=20
RRF_K=60
FINAL_TOP_K=5

# --- Legado (mantidos como fallback) ---------------------------------------
# Se DENSE_EMBED_MODEL não estiver setado, GOOGLE_MODEL é usado como fallback.
# Se CHAT_LLM_MODEL não estiver setado, MISTRAL_MODEL é usado como fallback.
# MISTRAL_MODEL="mistral-small-latest"
# GOOGLE_MODEL="text-embedding-004"
